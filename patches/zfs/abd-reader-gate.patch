From a2e86c7aa8a142e2859015a5df561fee46712907 Mon Sep 17 00:00:00 2001
From: ElXreno <elxreno@gmail.com>
Date: Sat, 15 Aug 2026 15:32:53 +0300
Subject: [PATCH] abd: hold a chunk still while it is being read

Relocating a chunk copies its contents, so it cannot run underneath a reader.
Count the readers of an abd that owns chunks, and have both sides meet through
the page: a reader raises the count and then looks at the isolation flag, while
relocation sets that flag and then looks at the count, so whichever arrives
second sees the first.

Nothing relocates yet, so nothing waits on this; it is the half that has to be
in place before the copy can be, and on its own it only adds one atomic to each
mapping of a chunk. Measured at the busiest this path gets on a desktop, a
hundred and fifty thousand mappings a second, that is under a fifth of a
percent of one core.
---
 include/os/linux/zfs/sys/abd_os.h | 11 ++++++
 include/sys/abd_impl.h            |  4 +++
 module/os/linux/zfs/abd_os.c      | 60 ++++++++++++++++++++++++++++++-
 3 files changed, 74 insertions(+), 1 deletion(-)

diff --git a/include/os/linux/zfs/sys/abd_os.h b/include/os/linux/zfs/sys/abd_os.h
index 8c4d5b7e1..5993d6098 100644
--- a/include/os/linux/zfs/sys/abd_os.h
+++ b/include/os/linux/zfs/sys/abd_os.h
@@ -27,6 +27,8 @@
 #ifndef _ABD_OS_H
 #define	_ABD_OS_H
 
+#include <linux/atomic.h>
+
 #ifdef __cplusplus
 extern "C" {
 #endif
@@ -37,6 +39,15 @@ struct abd_scatter {
 	uint_t		abd_offset;
 	uint_t		abd_nents;
 	struct scatterlist *abd_sgl;
+	/*
+	 * Threads currently reading the chunks through abd_iter_map() or with
+	 * a chunk handed to the block layer. Relocation of a chunk waits for
+	 * this to be zero, since it has to copy the contents and cannot do so
+	 * underneath a reader. Only an abd that owns its chunks uses this; the
+	 * ones made by abd_get_offset() point into this one's scatterlist and
+	 * gate on the owner they reach through the page.
+	 */
+	atomic_t	abd_readers;
 };
 
 struct abd_linear {
diff --git a/include/sys/abd_impl.h b/include/sys/abd_impl.h
index 6cf09849d..dcd04804d 100644
--- a/include/sys/abd_impl.h
+++ b/include/sys/abd_impl.h
@@ -49,6 +49,10 @@ struct sf_buf;
 #endif
 
 struct abd_iter {
+#if defined(_KERNEL) && defined(__linux__)
+	/* owner of the chunk this iterator is holding still, if any */
+	struct abd	*iter_gate;
+#endif
 	/* public interface */
 	union {
 		/* for abd_iter_map()/abd_iter_unmap() */
diff --git a/module/os/linux/zfs/abd_os.c b/module/os/linux/zfs/abd_os.c
index 2f81c224e..2f4d300f6 100644
--- a/module/os/linux/zfs/abd_os.c
+++ b/module/os/linux/zfs/abd_os.c
@@ -299,6 +299,56 @@ abd_page_owner(struct page *page)
 	return ((abd_t *)page_private(page));
 }
 
+/*
+ * Hold a chunk still while it is being read.
+ *
+ * Relocation copies a chunk's contents, so it cannot run underneath a reader.
+ * The two meet through the page: a reader raises the owner's count and then
+ * looks at the isolation flag, while relocation sets that flag and then looks
+ * at the count. Both orderings are made visible by the atomics themselves, so
+ * whichever arrives second sees the first, and only one of them proceeds.
+ *
+ * A reader that finds the chunk being relocated waits for the new page rather
+ * than failing: relocation is a copy of at most a few pages, and the caller
+ * has nothing useful to do with a refusal.
+ */
+static abd_t *
+abd_gate_enter(struct scatterlist *sg, struct page **pagep)
+{
+	for (;;) {
+		struct page *page = sg_page(sg);
+		abd_t *owner = abd_page_owner(page);
+
+		if (owner == NULL) {
+			*pagep = page;
+			return (NULL);
+		}
+
+		atomic_inc(&ABD_SCATTER(owner).abd_readers);
+
+		/*
+		 * Both conditions have to be rechecked under the count: the
+		 * flag for a relocation that started before us, and the page
+		 * itself for one that finished and moved the chunk elsewhere.
+		 */
+		if (likely(!PageMovableOpsIsolated(page) &&
+		    sg_page(sg) == page)) {
+			*pagep = page;
+			return (owner);
+		}
+
+		atomic_dec(&ABD_SCATTER(owner).abd_readers);
+		cpu_relax();
+	}
+}
+
+static void
+abd_gate_exit(abd_t *owner)
+{
+	if (owner != NULL)
+		atomic_dec(&ABD_SCATTER(owner).abd_readers);
+}
+
 /*
  * The page allocator asks whether a chunk can be relocated. Nothing is moved
  * yet: this half of the work only proves the path from compaction down to the
@@ -424,6 +474,8 @@ abd_alloc_chunks(abd_t *abd, size_t size)
 		schedule_timeout_interruptible(1);
 	}
 
+	atomic_set(&ABD_SCATTER(abd).abd_readers, 0);
+
 	sg = table.sgl;
 	remaining_size = size;
 	list_for_each_entry_safe(page, tmp_page, &pages, lru) {
@@ -508,6 +560,7 @@ abd_alloc_chunks(abd_t *abd, size_t size)
 	ASSERT3U(table.nents, ==, nr_pages);
 	ABD_SCATTER(abd).abd_sgl = table.sgl;
 	ABD_SCATTER(abd).abd_nents = nr_pages;
+	atomic_set(&ABD_SCATTER(abd).abd_readers, 0);
 
 	abd_for_each_sg(abd, sg, nr_pages, i) {
 		while ((page = __page_cache_alloc(gfp)) == NULL) {
@@ -1048,7 +1101,9 @@ abd_iter_map(struct abd_iter *aiter)
 		aiter->iter_mapsize = MIN(aiter->iter_sg->length - offset,
 		    aiter->iter_abd->abd_size - aiter->iter_pos);
 
-		struct page *page = sg_page(aiter->iter_sg);
+		struct page *page;
+		aiter->iter_gate = abd_gate_enter(aiter->iter_sg, &page);
+
 		if (PageHighMem(page)) {
 			page = nth_page(page, offset / PAGE_SIZE);
 			offset &= PAGE_SIZE - 1;
@@ -1081,6 +1136,9 @@ abd_iter_unmap(struct abd_iter *aiter)
 
 		/* LINTED E_FUNC_SET_NOT_USED */
 		zfs_kunmap_local(aiter->iter_mapaddr - offset);
+
+		abd_gate_exit(aiter->iter_gate);
+		aiter->iter_gate = NULL;
 	}
 
 	ASSERT3P(aiter->iter_mapaddr, !=, NULL);
-- 
2.55.0

