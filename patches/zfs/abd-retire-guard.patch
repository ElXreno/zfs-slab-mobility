From 036576f8ef982740d97cbe239728d9245bfb247b Mon Sep 17 00:00:00 2001
From: ElXreno <elxreno@gmail.com>
Date: Mon, 24 Aug 2026 04:21:58 +0300
Subject: [PATCH] abd: refuse to retire a chunk that is already at zero
 references

---
 module/os/linux/zfs/abd_os.c | 22 ++++++++++++++++++++++
 1 file changed, 22 insertions(+)

diff --git a/module/os/linux/zfs/abd_os.c b/module/os/linux/zfs/abd_os.c
index 979ff8801..6ac5851c8 100644
--- a/module/os/linux/zfs/abd_os.c
+++ b/module/os/linux/zfs/abd_os.c
@@ -652,6 +652,26 @@ abd_retire_page(struct scatterlist *sg)
 		 * Never offered for relocation, so nothing can be looking at
 		 * it and there is nothing to take the lock against.
 		 */
+		/*
+		 * Two is what a chunk this code owns holds: the allocation's
+		 * reference and the mark's. Unmarking below puts one, and the
+		 * free after it puts the last. A chunk that arrives holding
+		 * one has already lost the mark's somewhere else, and then the
+		 * unmark frees the page here, inside a function whose caller
+		 * is about to free it again.
+		 *
+		 * More than two is somebody holding the chunk, usually
+		 * compaction having isolated it, and that is what the wait
+		 * below is for. Only fewer is the broken case.
+		 */
+		if (unlikely(page_ref_count(page) < 2)) {
+			ABDSTAT_BUMP(abdstat_free_ref_short);
+			printk(KERN_ERR "abdrefs: declined to retire, "
+			    "ref %d order %d\n", page_ref_count(page),
+			    compound_order(page));
+			return (NULL);
+		}
+
 		if (abd_page_owner(page) == NULL) {
 			abd_unmark_movable_page(page);
 			return (page);
@@ -961,6 +981,8 @@ abd_free_chunks(abd_t *abd)
 	if (!abd_is_from_pages(abd)) {
 		abd_for_each_sg(abd, sg, nr_pages, i) {
 			page = abd_retire_page(sg);
+			if (page == NULL)
+				continue;
 			order = compound_order(page);
 			/*
 			 * Retiring dropped the reference the mark held, so one
-- 
