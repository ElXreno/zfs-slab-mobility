From 4d58ff76b46d3b2d3f23063e6663293368a11979 Mon Sep 17 00:00:00 2001
From: ElXreno <elxreno@gmail.com>
Date: Mon, 24 Aug 2026 04:21:58 +0300
Subject: [PATCH] abd: refuse to retire a chunk that is already at zero
 references

---
 module/os/linux/zfs/abd_os.c | 16 ++++++++++++++++
 1 file changed, 16 insertions(+)

diff --git a/module/os/linux/zfs/abd_os.c b/module/os/linux/zfs/abd_os.c
index 979ff8801..64c7fad46 100644
--- a/module/os/linux/zfs/abd_os.c
+++ b/module/os/linux/zfs/abd_os.c
@@ -652,6 +652,20 @@ abd_retire_page(struct scatterlist *sg)
 		 * Never offered for relocation, so nothing can be looking at
 		 * it and there is nothing to take the lock against.
 		 */
+		/*
+		 * Unmarking puts, and a put on a chunk that is already at zero
+		 * takes the count negative and hands the allocator a page it
+		 * has back. Whatever left it at zero happened elsewhere; all
+		 * that can be done here is to stop making it worse.
+		 */
+		if (unlikely(page_ref_count(page) < 1)) {
+			ABDSTAT_BUMP(abdstat_free_ref_short);
+			printk(KERN_ERR "abdrefs: declined to retire, "
+			    "ref %d order %d\n", page_ref_count(page),
+			    compound_order(page));
+			return (NULL);
+		}
+
 		if (abd_page_owner(page) == NULL) {
 			abd_unmark_movable_page(page);
 			return (page);
@@ -961,6 +975,8 @@ abd_free_chunks(abd_t *abd)
 	if (!abd_is_from_pages(abd)) {
 		abd_for_each_sg(abd, sg, nr_pages, i) {
 			page = abd_retire_page(sg);
+			if (page == NULL)
+				continue;
 			order = compound_order(page);
 			/*
 			 * Retiring dropped the reference the mark held, so one
-- 
