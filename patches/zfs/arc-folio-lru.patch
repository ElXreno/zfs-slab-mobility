@@ -255,7 +314,105 @@ abd_unmark_zfs_page(struct page *page)
 #define	abd_unmark_zfs_page(page)
 #endif /* _LP64 */
 
-#ifndef CONFIG_HIGHMEM
+#ifdef ABD_LRU
+
+/*
+ * Same placement policy as below, but every chunk is a folio no larger than
+ * the page cache accepts, allocated movable because once the buffer is clean
+ * the kernel is allowed to move it. A single chunk stays a scatter ABD: a
+ * cached linear address would go stale the moment the folio moved.
+ */
+void
+abd_alloc_chunks(abd_t *abd, size_t size)
+{
+	struct list_head folios;
+	struct sg_table table;
+	struct scatterlist *sg;
+	struct folio *folio, *tmp_folio = NULL;
+	gfp_t gfp = __GFP_MOVABLE | __GFP_NOWARN | GFP_NOIO;
+	gfp_t gfp_comp = (gfp | __GFP_NORETRY) & ~__GFP_RECLAIM;
+	unsigned int max_order = MIN(zfs_abd_scatter_max_order,
+	    MAX_PAGECACHE_ORDER);
+	unsigned int nr_pages = abd_chunkcnt_for_bytes(size);
+	unsigned int chunks = 0, zones = 0;
+	size_t remaining_size;
+	int nid = NUMA_NO_NODE;
+	unsigned int alloc_pages = 0;
+
+	INIT_LIST_HEAD(&folios);
+
+	ASSERT3U(alloc_pages, <, nr_pages);
+
+	while (alloc_pages < nr_pages) {
+		unsigned int order;
+
+		order = MIN(highbit64(nr_pages - alloc_pages) - 1, max_order);
+
+		if (nid == NUMA_NO_NODE)
+			folio = folio_alloc(order ? gfp_comp : gfp, order);
+		else
+			folio = __folio_alloc_node(order ? gfp_comp : gfp, order,
+			    nid);
+		if (folio == NULL) {
+			if (order == 0) {
+				ABDSTAT_BUMP(abdstat_scatter_page_alloc_retry);
+				schedule_timeout_interruptible(1);
+			} else {
+				max_order = MAX(0, order - 1);
+			}
+			continue;
+		}
+
+		list_add_tail(&folio->lru, &folios);
+
+		if ((nid != NUMA_NO_NODE) && (folio_nid(folio) != nid))
+			zones++;
+
+		nid = folio_nid(folio);
+		ABDSTAT_BUMP(abdstat_scatter_orders[order]);
+		chunks++;
+		alloc_pages += 1U << order;
+	}
+
+	ASSERT3S(alloc_pages, ==, nr_pages);
+
+	while (sg_alloc_table(&table, chunks, gfp)) {
+		ABDSTAT_BUMP(abdstat_scatter_sg_table_retry);
+		schedule_timeout_interruptible(1);
+	}
+
+	sg = table.sgl;
+	remaining_size = size;
+	list_for_each_entry_safe(folio, tmp_folio, &folios, lru) {
+		size_t sg_size = MIN(folio_size(folio), remaining_size);
+		sg_set_page(sg, &folio->page, sg_size, 0);
+		abd_mark_zfs_page(&folio->page);
+		remaining_size -= sg_size;
+
+		sg = sg_next(sg);
+		list_del(&folio->lru);
+	}
+
+	ASSERT0(ABD_SCATTER(abd).abd_offset);
