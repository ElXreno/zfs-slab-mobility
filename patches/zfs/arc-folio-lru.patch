diff --git a/config/kernel-arc-lru.m4 b/config/kernel-arc-lru.m4
new file mode 100644
index 0000000..25d96ae
--- /dev/null
+++ b/config/kernel-arc-lru.m4
@@ -0,0 +1,89 @@
+dnl # SPDX-License-Identifier: CDDL-1.0
+dnl #
+dnl # The folio backed scatter ABD keeps clean ARC buffers in the page cache
+dnl # of an anonymous inode, reclaimed through release_folio and moved through
+dnl # migrate_folio. Everything it calls has to be exported to a CDDL module,
+dnl # which for filemap_add_folio and filemap_remove_folio means a kernel
+dnl # carrying the export patch.
+dnl #
+m4_pattern_allow([AS_KERNEL_FILE])
+
+AC_DEFUN([ZFS_AC_KERNEL_SRC_ARC_LRU], [
+	ZFS_LINUX_TEST_SRC([arc_lru], [
+		#include <linux/fs.h>
+		#include <linux/fs_context.h>
+		#include <linux/pseudo_fs.h>
+		#include <linux/pagemap.h>
+		#include <linux/migrate.h>
+		#include <linux/swap.h>
+
+		static bool test_release(struct folio *folio, gfp_t gfp)
+		{
+			return (folio_ref_count(folio) ==
+			    folio_nr_pages(folio) + 2);
+		}
+
+		static int test_migrate(struct address_space *mapping,
+		    struct folio *dst, struct folio *src, enum migrate_mode mode)
+		{
+			int rc = folio_migrate_mapping(mapping, dst, src, 0);
+			if (rc != 0)
+				return (rc);
+			folio_copy(dst, src);
+			folio_attach_private(dst, folio_detach_private(src));
+			folio_migrate_flags(dst, src);
+			return (0);
+		}
+
+		static const struct address_space_operations test_aops = {
+			.release_folio = test_release,
+			.migrate_folio = test_migrate,
+			.dirty_folio = noop_dirty_folio,
+		};
+
+		static int test_fs_context(struct fs_context *fc)
+		{
+			return (init_pseudo(fc, 0x5a465341) ? 0 : -ENOMEM);
+		}
+
+		static struct file_system_type test_fs_type = {
+			.name = "zfs_arc_lru_test",
+			.owner = THIS_MODULE,
+			.init_fs_context = test_fs_context,
+			.kill_sb = kill_anon_super,
+		};
+	], [
+		struct vfsmount *mnt = NULL;
+		int count = 0;
+		struct inode *inode;
+		struct folio *folio = folio_alloc(GFP_KERNEL, 0);
+
+		(void) register_filesystem(&test_fs_type);
+		(void) simple_pin_fs(&test_fs_type, &mnt, &count);
+		inode = alloc_anon_inode(mnt->mnt_sb);
+		inode->i_mapping->a_ops = &test_aops;
+		mapping_set_large_folios(inode->i_mapping);
+		mapping_clear_unevictable(inode->i_mapping);
+		mapping_set_exiting(inode->i_mapping);
+		set_bit(AS_KERNEL_FILE, &inode->i_mapping->flags);
+		folio_change_private(folio, inode);
+		(void) filemap_add_folio(inode->i_mapping, folio,
+		    (pgoff_t)MAX_PAGECACHE_ORDER, GFP_NOIO);
+		folio_mark_accessed(folio);
+		filemap_remove_folio(folio);
+		iput(inode);
+		simple_release_fs(&mnt, &count);
+		unregister_filesystem(&test_fs_type);
+	], [], [ZFS_META_LICENSE])
+])
+
+AC_DEFUN([ZFS_AC_KERNEL_ARC_LRU], [
+	AC_MSG_CHECKING([whether the page cache can hold ARC folios])
+	ZFS_LINUX_TEST_RESULT([arc_lru_license], [
+		AC_MSG_RESULT(yes)
+		AC_DEFINE(HAVE_ARC_LRU, 1,
+		    [page cache primitives for ARC folios are exported])
+	], [
+		AC_MSG_RESULT(no)
+	])
+])
