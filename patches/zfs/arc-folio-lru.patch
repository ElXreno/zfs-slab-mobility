 	ABD_FLAG_ALLOCD		= 1 << 8, /* we allocated the abd_t */
 	ABD_FLAG_FROM_PAGES	= 1 << 9, /* does not own pages */
+	ABD_FLAG_LRU		= 1 << 10, /* pages sit in the kernel page cache */
+	ABD_FLAG_PRELOCKED	= 1 << 11, /* every chunk locked by this task */
 } abd_flags_t;
 
 typedef struct abd {
