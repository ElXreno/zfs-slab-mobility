+#ifdef ABD_LRU
+
+/*
+ * ARC LRU: the chunks of a clean ARC buffer sit in the page cache of one
+ * anonymous inode, so the kernel ages them next to everything else it caches,
+ * takes them back through release_folio when it is short of memory and moves
+ * them through migrate_folio when it compacts.
+ *
+ * A joined folio holds the abd_t in its private word; the mapping then owns one
+ * reference per page and the private word one more, the allocation reference
+ * is dropped. Anyone who needs the page for a while, an iterator or a bio,
+ * takes a reference through abd_sg_grab(), which is what keeps a chunk from
+ * being moved or given back under them: both kernel paths refuse a folio whose
+ * count is not exactly what they expect.
+ *
+ * Locks, outermost first: the owner's lock, abd_mtx, folio lock. Reclaim and
+ * migration arrive holding the folio lock and only ever try the other two, so
+ * nothing waits in a circle.
+ */
+
+#define	ABD_LRU_MAGIC	0x5a465341
+
+static struct vfsmount *abd_lru_mnt;
+static int abd_lru_mnt_count;
+static struct inode *abd_lru_inode;
+static struct address_space *abd_lru_mapping;
+static atomic64_t abd_lru_next_index;
+
+static inline boolean_t
+abd_is_lru(abd_t *abd)
+{
+	return ((abd->abd_flags & ABD_FLAG_LRU) != 0);
+}
+
+/*
+ * A reference on the folio behind an sg entry. Migration repoints the entry
+ * once the copy is made, so the reference counts only if the entry still names
+ * the folio it was taken on.
+ */
+static struct folio *
+abd_sg_grab(struct scatterlist *sg)
+{
+	for (;;) {
+		struct page *page = sg_page(sg);
+		struct folio *folio = page_folio(page);
+
+		if (folio_try_get(folio)) {
+			if (likely(sg_page(sg) == page))
+				return (folio);
+			folio_put(folio);
+		}
+		ABDSTAT_BUMP(abdstat_lru_grab_retry);
+		cpu_relax();
+	}
+}
+
+/*
+ * Only a chunk of ours may be referenced: a bio also carries slab pages, which
+ * the allocator keeps frozen at a count of zero, and a reference dropped on one
+ * of those would free it. A chunk is recognised by the marker it gets when
+ * allocated or by the mapping it joins.
+ */
+static boolean_t
+abd_lru_own_page(struct page *page)
+{
+	struct folio *folio = page_folio(page);
+
+	if (folio_test_slab(folio) || !folio_test_private(folio))
+		return (B_FALSE);
+
+	return (folio->mapping == abd_lru_mapping ||
+	    folio_get_private(folio) == (void *)ABD_FILE_CACHE_PAGE);
+}
+
+/* For a page an iterator has already grabbed, so a plain reference is safe. */
+void
+abd_lru_hold_page(struct page *page)
+{
+	if (abd_lru_own_page(page))
+		folio_get(page_folio(page));
+}
+
+void
+abd_lru_drop_page(struct page *page)
+{
+	if (abd_lru_own_page(page))
+		folio_put(page_folio(page));
+}
+
+static pgoff_t
+abd_lru_index(unsigned int order)
+{
+	uint64_t nr = 1ULL << order;
+	uint64_t old, idx;
+
+	do {
+		old = atomic64_read(&abd_lru_next_index);
+		idx = P2ROUNDUP(old, nr);
+	} while (atomic64_cmpxchg(&abd_lru_next_index, old, idx + nr) != old);
+
+	return ((pgoff_t)idx);
+}
+
+/* Drops the lock and the reference the reclaimer took on the first n chunks. */
+static void
+abd_lru_unlock_siblings(abd_t *abd, struct folio *keep, int n)
+{
+	struct scatterlist *sg = NULL;
+	int i = 0;
+
+	abd_for_each_sg(abd, sg, n, i) {
+		struct folio *sib = page_folio(sg_page(sg));
+
+		if (sib == keep)
+			continue;
+		folio_unlock(sib);
+		folio_put(sib);
+	}
+}
+
+/*
+ * Whoever frees a buffer from inside reclaim may not wait for a folio lock:
+ * the folios the caller already holds are unknown here, and one of them may
+ * well be the next chunk. Debug builds keep the reclaiming tasks on a list so
+ * that any path reaching the waiting branch is caught in the stand instead of
+ * on a machine.
+ */
+#ifdef ZFS_DEBUG
+#define	ABD_LRU_RECLAIMERS	64
+static struct task_struct *abd_lru_reclaimers[ABD_LRU_RECLAIMERS];
+static DEFINE_SPINLOCK(abd_lru_reclaimers_lock);
+
+static void
+abd_lru_reclaim_enter(void)
+{
+	unsigned long flags;
+	int i;
+
+	spin_lock_irqsave(&abd_lru_reclaimers_lock, flags);
+	for (i = 0; i < ABD_LRU_RECLAIMERS; i++) {
+		if (abd_lru_reclaimers[i] == NULL) {
+			abd_lru_reclaimers[i] = current;
+			break;
+		}
+	}
+	spin_unlock_irqrestore(&abd_lru_reclaimers_lock, flags);
+}
+
+static void
+abd_lru_reclaim_exit(void)
+{
+	unsigned long flags;
+	int i;
+
+	spin_lock_irqsave(&abd_lru_reclaimers_lock, flags);
+	for (i = 0; i < ABD_LRU_RECLAIMERS; i++) {
+		if (abd_lru_reclaimers[i] == current) {
+			abd_lru_reclaimers[i] = NULL;
+			break;
+		}
+	}
+	spin_unlock_irqrestore(&abd_lru_reclaimers_lock, flags);
+}
+
+static boolean_t
+abd_lru_in_reclaim(void)
+{
+	unsigned long flags;
+	boolean_t found = B_FALSE;
+	int i;
+
+	spin_lock_irqsave(&abd_lru_reclaimers_lock, flags);
+	for (i = 0; i < ABD_LRU_RECLAIMERS; i++) {
+		if (abd_lru_reclaimers[i] == current) {
+			found = B_TRUE;
+			break;
+		}
+	}
+	spin_unlock_irqrestore(&abd_lru_reclaimers_lock, flags);
+	return (found);
+}
+#else
+#define	abd_lru_reclaim_enter()
+#define	abd_lru_reclaim_exit()
+#define	abd_lru_in_reclaim()	(B_FALSE)
+#endif
+
+/*
+ * Takes every chunk of a buffer the reclaimer is about to free along with the
+ * one it was called on: an owner frees all of its buffers in one go, and by
+ * then nothing may block. Refusing costs only the folio staying where it is.
+ */
+boolean_t
+abd_lru_try_prelock(abd_t *abd)
+{
+	struct scatterlist *sg = NULL;
+	int i = 0;
+
+	if (abd == NULL || !abd_is_lru(abd))
+		return (B_TRUE);
+
+	ASSERT(!abd_is_linear(abd));
+
+	if (!mutex_tryenter(&abd->abd_mtx)) {
+		ABDSTAT_BUMP(abdstat_lru_prelock_busy);
+		return (B_FALSE);
+	}
+
+	abd_for_each_sg(abd, sg, ABD_SCATTER(abd).abd_nents, i) {
+		struct folio *sib = abd_sg_grab(sg);
+
+		if (folio_trylock(sib)) {
+			if (likely(sg_page(sg) == &sib->page))
+				continue;
+			folio_unlock(sib);
+		}
+		folio_put(sib);
+		abd_lru_unlock_siblings(abd, NULL, i);
+		mutex_exit(&abd->abd_mtx);
+		ABDSTAT_BUMP(abdstat_lru_prelock_busy);
+		return (B_FALSE);
+	}
+
+	abd->abd_flags |= ABD_FLAG_PRELOCKED;
+	return (B_TRUE);
+}
+
+/* Undoes a prelock the owner ended up not freeing. */
+void
+abd_lru_prelock_release(abd_t *abd)
+{
+	if (abd == NULL || !(abd->abd_flags & ABD_FLAG_PRELOCKED))
+		return;
+
+	ASSERT(MUTEX_HELD(&abd->abd_mtx));
+	abd->abd_flags &= ~ABD_FLAG_PRELOCKED;
+	abd_lru_unlock_siblings(abd, NULL, ABD_SCATTER(abd).abd_nents);
+	mutex_exit(&abd->abd_mtx);
+}
+
+static bool
+abd_lru_release_folio(struct folio *folio, gfp_t gfp)
+{
+	abd_t *abd = folio_get_private(folio);
+	const abd_lru_ops_t *ops;
+	kmutex_t *lock = NULL;
+	struct scatterlist *sg = NULL;
+	void *arg;
+	int i = 0;
+
+	ASSERT(folio_test_locked(folio));
+
+	(void) gfp;
+	if (abd == NULL)
+		return (true);
+
+	if (folio_ref_count(folio) != folio_nr_pages(folio) + 2) {
+		ABDSTAT_BUMP(abdstat_lru_release_busy);
+		return (false);
+	}
+
+	if (!mutex_tryenter(&abd->abd_mtx)) {
+		ABDSTAT_BUMP(abdstat_lru_release_lock_miss);
+		return (false);
+	}
+
+	ops = ABD_SCATTER(abd).abd_lru_ops;
+	arg = ABD_SCATTER(abd).abd_lru_arg;
+	if (ops != NULL && arg != NULL)
+		lock = ops->lru_lock(arg);
+	if (lock == NULL) {
+		mutex_exit(&abd->abd_mtx);
+		ABDSTAT_BUMP(abdstat_lru_release_lock_miss);
+		return (false);
+	}
+
+	/*
+	 * Every other chunk of the ABD is taken here, referenced and locked,
+	 * with a try: the caller can be a migration batch that already holds
+	 * some of them, and a free path that waited for a lock held by the task
+	 * it runs in would never return.
+	 */
+	abd_for_each_sg(abd, sg, ABD_SCATTER(abd).abd_nents, i) {
+		struct folio *sib = abd_sg_grab(sg);
+		boolean_t taken = B_FALSE;
+
+		if (sib == folio) {
+			folio_put(sib);
+			continue;
+		}
+		if (folio_trylock(sib)) {
+			if (likely(sg_page(sg) == &sib->page))
+				continue;
+			taken = B_TRUE;
+		}
+		if (taken)
+			folio_unlock(sib);
+		folio_put(sib);
+		abd_lru_unlock_siblings(abd, folio, i);
+		mutex_exit(&abd->abd_mtx);
+		mutex_exit(lock);
+		ABDSTAT_BUMP(abdstat_lru_release_busy);
+		return (false);
+	}
+
+	/*
+	 * The owner frees the whole ABD. Its free path leaves this folio to
+	 * the reclaimer, unlocks the others and releases abd_mtx on the way
+	 * out, because the mutex dies with the ABD; afterwards only the folio
+	 * may be looked at, and its private word says whether the ABD is
+	 * still there.
+	 */
+	ABD_SCATTER(abd).abd_reclaiming = folio;
+	abd->abd_flags |= ABD_FLAG_PRELOCKED;
+	abd_lru_reclaim_enter();
+	(void) ops->lru_evict(arg, abd);
+	abd_lru_reclaim_exit();
+	if (folio_test_private(folio)) {
+		abd->abd_flags &= ~ABD_FLAG_PRELOCKED;
+		ABD_SCATTER(abd).abd_reclaiming = NULL;
+		abd_lru_unlock_siblings(abd, folio, ABD_SCATTER(abd).abd_nents);
+		mutex_exit(&abd->abd_mtx);
+		mutex_exit(lock);
+		ABDSTAT_BUMP(abdstat_lru_release_refused);
+		return (false);
+	}
+
+	mutex_exit(lock);
+	ABDSTAT_BUMP(abdstat_lru_release);
+	return (true);
+}
+
+static int
+abd_lru_migrate_folio(struct address_space *mapping, struct folio *dst,
+    struct folio *src, enum migrate_mode mode)
+{
+	abd_t *abd = folio_get_private(src);
+	struct scatterlist *sg = NULL;
+	boolean_t found = B_FALSE;
+	int rc, i = 0;
+
+	ABDSTAT_BUMP(abdstat_page_isolate_asked);
+	/* Left behind by a split after the ABD was evicted: plain page cache. */
+	if (abd == NULL)
+		return (migrate_folio(mapping, dst, src, mode));
+
+	rc = folio_migrate_mapping(mapping, dst, src, 0);
+	if (rc != 0) {
+		ABDSTAT_BUMP(abdstat_page_migrate_busy);
+		return (rc);
+	}
+
+	folio_copy(dst, src);
+	folio_attach_private(dst, folio_detach_private(src));
+
+	abd_for_each_sg(abd, sg, ABD_SCATTER(abd).abd_nents, i) {
+		if (sg_page(sg) == &src->page) {
+			sg_set_page(sg, &dst->page, sg->length, sg->offset);
+			found = B_TRUE;
+			break;
+		}
+	}
+	VERIFY(found);
+
+	folio_migrate_flags(dst, src);
+	ABDSTAT_BUMP(abdstat_page_migrated);
+	return (0);
+}
+
+void
+abd_lru_join(abd_t *abd, const abd_lru_ops_t *ops, void *arg)
+{
+	struct scatterlist *sg = NULL;
+	int64_t bytes = 0, folios = 0;
+	int i = 0;
+
+	if (abd_lru_mapping == NULL || abd_is_linear(abd) ||
+	    abd_is_gang(abd) || abd_is_from_pages(abd) ||
+	    !(abd->abd_flags & ABD_FLAG_OWNER) || abd_is_lru(abd))
+		return;
+
+	mutex_enter(&abd->abd_mtx);
+	ABD_SCATTER(abd).abd_lru_ops = ops;
+	ABD_SCATTER(abd).abd_lru_arg = arg;
+	abd->abd_flags |= ABD_FLAG_LRU;
+
+	abd_for_each_sg(abd, sg, ABD_SCATTER(abd).abd_nents, i) {
+		struct folio *folio = page_folio(sg_page(sg));
+
+		ASSERT(folio_test_private(folio));
+		folio_change_private(folio, abd);
+		if (filemap_add_folio(abd_lru_mapping, folio,
+		    abd_lru_index(folio_order(folio)),
+		    GFP_NOIO | __GFP_NOWARN) != 0) {
+			folio_change_private(folio,
+			    (void *)ABD_FILE_CACHE_PAGE);
+			ABDSTAT_BUMP(abdstat_lru_join_fail);
+			continue;
+		}
+		folio_mark_uptodate(folio);
+		folio_unlock(folio);
+		folio_put(folio);
+		bytes += sg->length;
+		folios++;
+	}
+	mutex_exit(&abd->abd_mtx);
+
+	ABDSTAT_INCR(abdstat_lru_bytes, bytes);
+	ABDSTAT_INCR(abdstat_lru_folios, folios);
+	ABDSTAT_BUMP(abdstat_lru_join);
+}
+
+void
+abd_lru_rebind(abd_t *abd, void *arg)
+{
+	if (abd == NULL || abd_is_linear(abd) || abd_is_gang(abd) ||
+	    !abd_is_lru(abd))
+		return;
+
+	mutex_enter(&abd->abd_mtx);
+	ABD_SCATTER(abd).abd_lru_arg = arg;
+	if (arg == NULL)
+		ABD_SCATTER(abd).abd_lru_ops = NULL;
+	mutex_exit(&abd->abd_mtx);
+}
+
+void
+abd_lru_touch(abd_t *abd)
+{
+	struct scatterlist *sg = NULL;
+	int i = 0;
+
+	if (abd == NULL || abd_is_linear(abd) || abd_is_gang(abd) ||
+	    !abd_is_lru(abd))
+		return;
+
+	abd_for_each_sg(abd, sg, ABD_SCATTER(abd).abd_nents, i) {
+		struct folio *folio = abd_sg_grab(sg);
+		folio_mark_accessed(folio);
+		folio_put(folio);
+	}
+}
+
+uint64_t
+abd_lru_bytes(void)
+{
+	return (wmsum_value(&abd_sums.abdstat_lru_bytes));
+}
+
+/*
+ * Called with abd_mtx held and every chunk already referenced and locked when
+ * the reclaimer is the one freeing. abd_reclaiming, if set, names the folio it
+ * was called on: that one is only detached, the kernel takes it out of the
+ * mapping and frees it itself.
+ */
+static void
+abd_lru_free_chunks(abd_t *abd)
+{
+	struct scatterlist *sg = NULL;
+	struct folio *reclaiming;
+	boolean_t prelocked = (abd->abd_flags & ABD_FLAG_PRELOCKED) != 0;
+	boolean_t need_lock = !MUTEX_HELD(&abd->abd_mtx);
+	int nr_pages = ABD_SCATTER(abd).abd_nents;
+	int64_t bytes = 0, folios = 0;
+	int i = 0;
+
+	might_sleep();
+
+	if (need_lock)
+		mutex_enter(&abd->abd_mtx);
+	reclaiming = ABD_SCATTER(abd).abd_reclaiming;
+	IMPLY(!need_lock, prelocked);
+	IMPLY(reclaiming != NULL, prelocked);
+	ASSERT(prelocked || !abd_lru_in_reclaim());
+
+	abd_for_each_sg(abd, sg, nr_pages, i) {
+		struct folio *folio;
+		int order;
+
+		if (reclaiming != NULL &&
+		    page_folio(sg_page(sg)) == reclaiming) {
+			folio = reclaiming;
+			ASSERT(folio_test_locked(folio));
+			ASSERT3P(folio_get_private(folio), ==, abd);
+			order = folio_order(folio);
+			folio_detach_private(folio);
+			bytes += sg->length;
+			folios++;
+			ABDSTAT_BUMPDOWN(abdstat_scatter_orders[order]);
+			continue;
+		}
+
+		if (prelocked) {
+			folio = page_folio(sg_page(sg));
+			ASSERT(folio_test_locked(folio));
+		} else {
+			for (;;) {
+				folio = abd_sg_grab(sg);
+				folio_lock(folio);
+				if (likely(sg_page(sg) == &folio->page))
+					break;
+				folio_unlock(folio);
+				folio_put(folio);
+			}
+		}
+		order = folio_order(folio);
+		if (folio->mapping == abd_lru_mapping) {
+			ASSERT3P(folio_get_private(folio), ==, abd);
+			filemap_remove_folio(folio);
+			folio_detach_private(folio);
+			folio_unlock(folio);
+			folio_put(folio);
+			bytes += sg->length;
+			folios++;
+		} else {
+			folio_unlock(folio);
+			abd_unmark_zfs_page(&folio->page);
+			folio_put(folio);
+			folio_put(folio);
+		}
+		ABDSTAT_BUMPDOWN(abdstat_scatter_orders[order]);
+	}
+
+	ABDSTAT_INCR(abdstat_lru_bytes, -bytes);
+	ABDSTAT_INCR(abdstat_lru_folios, -folios);
+	mutex_exit(&abd->abd_mtx);
+}
+
+/*
+ * Only the module's own pinned mount, never one from userspace, so the type
+ * needs no owner: a mount owned by the module would pin it and the module
+ * could never be unloaded to release the mount.
+ */
+static int
+abd_lru_init_fs_context(struct fs_context *fc)
+{
+	if (!(fc->sb_flags & SB_KERNMOUNT))
+		return (-EPERM);
+	return (init_pseudo(fc, ABD_LRU_MAGIC) ? 0 : -ENOMEM);
+}
+
+static struct file_system_type abd_lru_fs_type = {
+	.name = "zfs_arc",
+	.init_fs_context = abd_lru_init_fs_context,
+	.kill_sb = kill_anon_super,
+};
+
+static const struct address_space_operations abd_lru_aops = {
+	.release_folio = abd_lru_release_folio,
+	.migrate_folio = abd_lru_migrate_folio,
+	.dirty_folio = noop_dirty_folio,
+};
+
+static void
+abd_lru_init(void)
+{
+	struct inode *inode;
+
+	if (register_filesystem(&abd_lru_fs_type) != 0)
+		return;
+	if (simple_pin_fs(&abd_lru_fs_type, &abd_lru_mnt,
+	    &abd_lru_mnt_count) != 0) {
+		unregister_filesystem(&abd_lru_fs_type);
+		return;
+	}
+	inode = alloc_anon_inode(abd_lru_mnt->mnt_sb);
+	if (IS_ERR(inode)) {
+		simple_release_fs(&abd_lru_mnt, &abd_lru_mnt_count);
+		unregister_filesystem(&abd_lru_fs_type);
+		return;
+	}
+
