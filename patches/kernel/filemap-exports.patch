From 25f0f12a50516164f90e946ba1d9ab6a2ad714c4 Mon Sep 17 00:00:00 2001
From: ElXreno <elxreno@gmail.com>
Date: Mon, 7 Sep 2026 01:19:57 +0300
Subject: [PATCH] mm/filemap: export filemap_add_folio and filemap_remove_folio

Export the two page cache entry points a cache living in a hidden mapping
needs: filemap_add_folio is GPL-only and filemap_remove_folio is not
exported at all. Everything else the ARC folio backend uses has a plain
export already. Research build only.
---
 mm/filemap.c | 3 ++-
 1 file changed, 2 insertions(+), 1 deletion(-)

diff --git a/mm/filemap.c b/mm/filemap.c
index b72f8c2..274c0bf 100644
--- a/mm/filemap.c
+++ b/mm/filemap.c
@@ -263,6 +263,7 @@ void filemap_remove_folio(struct folio *folio)
 
 	filemap_free_folio(mapping, folio);
 }
+EXPORT_SYMBOL(filemap_remove_folio);
 
 /*
  * page_cache_delete_batch - delete several folios from page cache
@@ -988,7 +989,7 @@ int filemap_add_folio(struct address_space *mapping, struct folio *folio,
 	}
 	return ret;
 }
-EXPORT_SYMBOL_GPL(filemap_add_folio);
+EXPORT_SYMBOL(filemap_add_folio);
 
 #ifdef CONFIG_NUMA
 struct folio *filemap_alloc_folio_noprof(gfp_t gfp, unsigned int order,
-- 
2.55.0

