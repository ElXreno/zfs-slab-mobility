From d420ae553a825ed26848f7bcf17409501e8aa4c8 Mon Sep 17 00:00:00 2001
From: ElXreno <elxreno@gmail.com>
Date: Mon, 7 Sep 2026 01:19:57 +0300
Subject: [PATCH] mm/filemap: export page cache entry points for a
 hidden-mapping cache

Export the page cache entry points a cache living in a hidden mapping
needs: filemap_add_folio is GPL-only and filemap_remove_folio is not
exported at all. Add filemap_add_folio_active for a caller that wants
the folio on the active list: filemap_add_folio warns about a folio
that is already active, and folio_activate is not exported. Everything
else the ARC folio backend uses has a plain export already. Research
build only.
---
 include/linux/pagemap.h |  2 ++
 mm/filemap.c            | 22 +++++++++++++++++++---
 2 files changed, 21 insertions(+), 3 deletions(-)

diff --git a/include/linux/pagemap.h b/include/linux/pagemap.h
index 2c3718d..d4dc472 100644
--- a/include/linux/pagemap.h
+++ b/include/linux/pagemap.h
@@ -1284,6 +1284,8 @@ int add_to_page_cache_lru(struct page *page, struct address_space *mapping,
 		pgoff_t index, gfp_t gfp);
 int filemap_add_folio(struct address_space *mapping, struct folio *folio,
 		pgoff_t index, gfp_t gfp);
+int filemap_add_folio_active(struct address_space *mapping,
+		struct folio *folio, pgoff_t index, gfp_t gfp);
 void filemap_remove_folio(struct folio *folio);
 void __filemap_remove_folio(struct folio *folio, void *shadow);
 void replace_page_cache_folio(struct folio *old, struct folio *new);
diff --git a/mm/filemap.c b/mm/filemap.c
index ebc51fa..4fd9902 100644
--- a/mm/filemap.c
+++ b/mm/filemap.c
@@ -262,6 +262,7 @@ void filemap_remove_folio(struct folio *folio)
 
 	filemap_free_folio(mapping, folio);
 }
+EXPORT_SYMBOL(filemap_remove_folio);
 
 /*
  * page_cache_delete_batch - delete several folios from page cache
@@ -952,8 +953,8 @@ error:
 }
 ALLOW_ERROR_INJECTION(__filemap_add_folio, ERRNO);
 
-int filemap_add_folio(struct address_space *mapping, struct folio *folio,
-				pgoff_t index, gfp_t gfp)
+static int __filemap_add_folio_lru(struct address_space *mapping,
+		struct folio *folio, pgoff_t index, gfp_t gfp, bool active)
 {
 	void *shadow = NULL;
 	int ret;
@@ -985,6 +986,8 @@ int filemap_add_folio(struct address_space *mapping, struct folio *folio,
 		WARN_ON_ONCE(folio_test_active(folio));
 		if (!(gfp & __GFP_WRITE) && shadow)
 			workingset_refault(folio, shadow);
+		if (active)
+			folio_set_active(folio);
 		folio_add_lru(folio);
 		if (kernel_file)
 			mod_node_page_state(folio_pgdat(folio),
@@ -993,7 +996,20 @@ int filemap_add_folio(struct address_space *mapping, struct folio *folio,
 	}
 	return ret;
 }
-EXPORT_SYMBOL_GPL(filemap_add_folio);
+
+int filemap_add_folio(struct address_space *mapping, struct folio *folio,
+				pgoff_t index, gfp_t gfp)
+{
+	return __filemap_add_folio_lru(mapping, folio, index, gfp, false);
+}
+EXPORT_SYMBOL(filemap_add_folio);
+
+int filemap_add_folio_active(struct address_space *mapping,
+		struct folio *folio, pgoff_t index, gfp_t gfp)
+{
+	return __filemap_add_folio_lru(mapping, folio, index, gfp, true);
+}
+EXPORT_SYMBOL(filemap_add_folio_active);
 
 #ifdef CONFIG_NUMA
 struct folio *filemap_alloc_folio_noprof(gfp_t gfp, unsigned int order,
-- 
2.55.0

